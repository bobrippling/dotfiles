{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    // how nvim resolves require() calls
    "path": [
      "?.lua",
      "?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      "${env:HOME}/.local/share/nvim/runtime/lua"
    ],
    // don't prompt to configure third-party library defs
    "checkThirdParty": false
  }
}
